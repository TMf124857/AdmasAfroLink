{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=${POSTGRES_HOST:localhost};Database=${POSTGRES_DB:AdmasAfroLinkDB};Username=${POSTGRES_USER:postgres};Password=${POSTGRES_PASSWORD:postgres};Port=${POSTGRES_PORT:5432};Pooling=true;MaxPoolSize=20;CommandTimeout=30;"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "${JWT_ISSUER:AdmasAfroLink}",
    "Audience": "${JWT_AUDIENCE:AdmasAfroLinkUsers}",
    "ExpirationInMinutes": "${JWT_EXPIRATION_MINUTES:60}"
  },
  "Authentication": {
    "Google": {
      "ClientId": "${GOOGLE_CLIENT_ID}",
      "ClientSecret": "${GOOGLE_CLIENT_SECRET}"
    },
    "Facebook": {
      "AppId": "${FACEBOOK_APP_ID}",
      "AppSecret": "${FACEBOOK_APP_SECRET}"
    }
  },
  "AppSettings": {
    "FrontendUrl": "${FRONTEND_URL:https://admasafrolink.com}",
    "ApiUrl": "${API_URL:https://api.admasafrolink.com}",
    "AllowedFileTypes": "jpg,jpeg,png,gif,pdf,doc,docx",
    "MaxFileSize": "${MAX_FILE_SIZE:5242880}",
    "EnableSwagger": "${ENABLE_SWAGGER:false}",
    "EnableDetailedErrors": "${ENABLE_DETAILED_ERRORS:false}"
  },
  "EmailSettings": {
    "SmtpServer": "${SMTP_SERVER:smtp.gmail.com}",
    "SmtpPort": "${SMTP_PORT:587}",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "FromEmail": "${FROM_EMAIL:noreply@admasafrolink.com}",
    "FromName": "${FROM_NAME:AdmasAfroLink}",
    "EnableSsl": "${SMTP_ENABLE_SSL:true}"
  },
  "CacheSettings": {
    "RedisConnectionString": "${REDIS_CONNECTION_STRING}",
    "EnableRedis": "${ENABLE_REDIS:false}",
    "DefaultCacheTimeMinutes": "${DEFAULT_CACHE_TIME:30}"
  },
  "FileStorageSettings": {
    "StorageType": "${STORAGE_TYPE:Local}",
    "LocalPath": "${LOCAL_STORAGE_PATH:/app/wwwroot/uploads}",
    "AwsAccessKey": "${AWS_ACCESS_KEY_ID}",
    "AwsSecretKey": "${AWS_SECRET_ACCESS_KEY}",
    "AwsS3Bucket": "${AWS_S3_BUCKET}",
    "AwsRegion": "${AWS_REGION:us-east-1}",
    "CloudinaryCloudName": "${CLOUDINARY_CLOUD_NAME}",
    "CloudinaryApiKey": "${CLOUDINARY_API_KEY}",
    "CloudinaryApiSecret": "${CLOUDINARY_API_SECRET}"
  },
  "SecuritySettings": {
    "EnableCors": "${ENABLE_CORS:true}",
    "AllowedOrigins": "${ALLOWED_ORIGINS:https://admasafrolink.com,https://www.admasafrolink.com}",
    "EnableHttpsRedirection": "${ENABLE_HTTPS_REDIRECTION:true}",
    "EnableHsts": "${ENABLE_HSTS:true}",
    "RequireHttpsMetadata": "${REQUIRE_HTTPS_METADATA:true}"
  },
  "MonitoringSettings": {
    "EnableHealthChecks": "${ENABLE_HEALTH_CHECKS:true}",
    "EnableMetrics": "${ENABLE_METRICS:false}",
    "ApplicationInsightsKey": "${APPLICATION_INSIGHTS_KEY}",
    "SentryDsn": "${SENTRY_DSN}"
  }
}
