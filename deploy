#!/bin/bash

# Deployment Agent Launcher
# This script sets up the environment and runs the deployment agent

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_SCRIPT="${SCRIPT_DIR}/deployment-agent.sh"
CONFIG_FILE="${SCRIPT_DIR}/deployment-agent.conf"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Function to print colored output
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if deployment agent exists
if [[ ! -f "$AGENT_SCRIPT" ]]; then
    log_error "Deployment agent script not found: $AGENT_SCRIPT"
    exit 1
fi

# Make sure it's executable
chmod +x "$AGENT_SCRIPT"

# Check if config file exists
if [[ ! -f "$CONFIG_FILE" ]]; then
    log_warn "Configuration file not found: $CONFIG_FILE"
    log_info "Using default configuration from script"
fi

# Show usage if no arguments provided
if [[ $# -eq 0 ]]; then
    echo "AdmasAfroLink Deployment Agent"
    echo "=============================="
    echo ""
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Commands:"
    echo "  setup           - Initial setup and configuration"
    echo "  deploy          - Deploy current changes to server"
    echo "  test            - Test server deployment"
    echo "  auto            - Auto mode: watch for changes and deploy"
    echo "  monitor         - Monitor deployment status"
    echo "  rollback        - Rollback to previous version"
    echo "  status          - Show current status"
    echo "  logs            - Show deployment logs"
    echo ""
    echo "Examples:"
    echo "  $0 setup                    # First-time setup"
    echo "  $0 deploy                   # Deploy current changes"
    echo "  $0 auto                     # Start auto-deployment mode"
    echo "  $0 test --health-check      # Test with health check"
    echo ""
    exit 0
fi

# Run the deployment agent with provided arguments
log_info "Starting deployment agent with command: $1"
"$AGENT_SCRIPT" "$@"

exit_code=$?

if [[ $exit_code -eq 0 ]]; then
    log_info "Deployment agent completed successfully"
else
    log_error "Deployment agent failed with exit code: $exit_code"
fi

exit $exit_code
