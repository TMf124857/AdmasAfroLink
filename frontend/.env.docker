# AdmasAfroLink Docker Environment Configuration
# Copy this file to .env and update the values

# Application Configuration
APP_NAME=AdmasAfroLink
APP_VERSION=1.0.0
NODE_ENV=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AdmasAfroLink
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_DEBUG_MODE=true

# Backend Configuration
BACKEND_PORT=8000
API_PREFIX=/api/v1

# Database Configuration
MONGO_PASSWORD=admasafrolink2025
MONGO_USERNAME=admin
MONGO_DATABASE=admasafrolink
MONGO_PORT=27017

# Redis Configuration
REDIS_PASSWORD=admasafrolink2025
REDIS_PORT=6379

# File Storage Configuration
MINIO_ROOT_USER=admasafrolink
MINIO_ROOT_PASSWORD=admasafrolink2025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here
SESSION_SECRET=your-super-secret-session-key-here

# Email Configuration (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@admasafrolink.com

# External APIs
UGANDA_EMBASSY_API_KEY=
BELGIUM_EDU_API_KEY=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# Development specific
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# Production specific (uncomment for production)
# NODE_ENV=production
# NEXT_PUBLIC_DEBUG_MODE=false
# LOG_LEVEL=info
