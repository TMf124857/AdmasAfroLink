# AdmasAfroLink Environment Configuration
# Copy this file to .env and update with your actual values

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_DB=AdmasAfroLinkDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# ==========================================
# API Configuration
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET_KEY=YourSuperSecretKeyThatIsAtLeast32CharactersLongForAdmasAfroLink2025!

# ==========================================
# Email Configuration
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
FROM_EMAIL=noreply@admasafrolink.com
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# ==========================================
# Admin Tools
# ==========================================
PGADMIN_EMAIL=admin@admasafrolink.com
PGADMIN_PASSWORD=admin123

# ==========================================
# External Services
# ==========================================
# Google Analytics
NEXT_PUBLIC_GA_ID=GA_MEASUREMENT_ID

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ==========================================
# Development Settings
# ==========================================
NODE_ENV=development
NEXT_PUBLIC_DEBUG_MODE=true
ENVIRONMENT=development
